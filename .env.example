APP_PORT=8080
DATABASE_URL=postgres://golem:golem@localhost:5433/golem_chatbot
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=            # optional proxy
# OPENAI_API_KEY=             # optional — lights up OpenAI models in the picker
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=          # optional — lights up Anthropic models in the picker
# ANTHROPIC_BASE_URL=
JWT_SECRET=0123456789abcdef0123456789abcdef
FRONTEND_ORIGIN=http://localhost:5173
# Public SPA URL used in emailed links (defaults to FRONTEND_ORIGIN)
#APP_URL=http://localhost:5173
# --- Auth lifecycle ---
#EMAIL_VERIFICATION_REQUIRED=false  # gate password login on a verified email
#EMAIL_LOG_LINKS=false              # dev only: print reset/verify links when SMTP is unset
#AUTH_RATE_LIMIT_MAX=20             # attempts per window per IP (+email for login/forgot); 0 disables
#AUTH_RATE_LIMIT_WINDOW=15m
#TRUSTED_PROXIES=                   # comma-separated CIDRs allowed to supply X-Forwarded-For
# --- SMTP (optional; unset uses the log mailer) ---
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=
#SMTP_IMPLICIT_TLS=false            # true for port 465
#SMTP_ALLOW_PLAINTEXT=false
# --- Social login (optional; unconfigured providers stay hidden) ---
# Register each callback URL with the provider, e.g.
# http://localhost:8080/api/auth/oauth/google/callback
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
#OAUTH_REDIRECT_BASE=           # defaults to http://localhost:$APP_PORT
CHAT_INPUT_USD_PER_MTOK=0.30
CHAT_OUTPUT_USD_PER_MTOK=2.50
#TITLE_MODEL=gemini-2.5-flash  # optional: async model-generated conversation titles
#ALLOW_USER_PROVIDER_KEYS=false # let users store their own provider keys (BYOK)

# --- Always-on bots (archived bots do not count toward the limit) ---
#MAX_BOTS_PER_USER=20

# --- Bot runner (in-process worker that drains the bot task queue) ---
#BOT_RUNNER_ENABLED=true    # false = queued bot tasks are never executed
#BOT_RUNNER_CONCURRENCY=2   # max runs executing or parked-for-approval at once
#BOT_RUNNER_POLL_MS=2000    # fallback claim cadence; enqueues wake it immediately
#BOT_ROUTINE_TICK_MS=30000  # routine scheduler cadence; due occurrences fire on the next tick
#MAX_ROUTINES_PER_BOT=10    # cron routines one always-on bot may keep
#BOT_FILE_MAX_BYTES=262144  # per-call content cap for a bot's write_file tool

# --- Web Search (optional; lights up built-in web_search tool) ---
# Supports Wigolo (local-first/Docker), Tavily (TAVILY_API_KEY) or Brave Search (BRAVE_API_KEY).
#WEB_SEARCH_PROVIDER=wigolo        # wigolo, tavily, brave, or free
#WIGOLO_URL=http://localhost:3333 # or http://wigolo:3333 in docker compose
#WIGOLO_PATH=                     # optional local path to dist/index.js if running CLI directly
#WIGOLO_API_TOKEN=                # optional bearer token if Wigolo serve auth is enabled
#TAVILY_API_KEY=
#BRAVE_API_KEY=
#WEB_SEARCH_REQUIRE_APPROVAL=true # ask user before making outbound web searches

# --- Semantic message search (opt-in; reranks FTS candidates with embeddings) ---
#SEMANTIC_SEARCH_ENABLED=false    # requires GEMINI_API_KEY
# --- RAG (docker compose --profile rag up -d first) ---
#RAG_ENABLED=true
#WEAVIATE_URL=http://localhost:8081
#MINIO_ENDPOINT=localhost:9000
#MINIO_ACCESS_KEY=golem
#MINIO_SECRET_KEY=golem1234
#EMBEDDING_MODEL=gemini-embedding-001
#EMBEDDING_DIMS=768
#EMBEDDING_INPUT_USD_PER_MTOK=0.15
#MAX_UPLOAD_BYTES=20971520
# --- RAG retrieval tuning ---
#RETRIEVAL_ALPHA=0.5
#RETRIEVE_MULT=4
#RERANK_MAX_CANDIDATES=40
#RERANK_ENABLED=true
#RERANK_MODEL=gemini-2.5-flash
#CHUNK_TARGET_TOKENS=512
#CHUNK_OVERLAP_TOKENS=64
#EXPAND_BEFORE=1
#EXPAND_AFTER=1
# --- Context compaction ---
#COMPACTION_ENABLED=true
#COMPACTION_MODEL=gemini-2.5-flash
#COMPACTION_THRESHOLD_TOKENS=40000
#COMPACTION_KEEP_RECENT=10
#COMPACTION_SUMMARY_TOKENS=800
